# =============================================================================
#  astro-payload-treenweb — environment template
#  Copy to `.env` for local/Docker development. NEVER commit a real `.env`.
#  Every variable here MUST also be declared in the relevant app's Zod
#  `env` schema (added in Step 6). If a var is not in this file, it does
#  not exist.
# =============================================================================

# ─── Shared ──────────────────────────────────────────────────────────────────
NODE_ENV=development

# Public site origin (browser-visible). Drives canonical URLs / sitemap.
PUBLIC_SITE_URL=http://localhost:4321
# Public CMS origin (browser-visible, only for client-side API calls).
PUBLIC_CMS_URL=http://localhost:3000

# ─── Frontend (Astro SSR) ────────────────────────────────────────────────────
# Server-side ONLY. Internal Docker network URL used for SSR data fetching.
# Must be the compose service name, not localhost.
PAYLOAD_INTERNAL_URL=http://backend:3000

# Plausible Analytics — the script is injected only when BOTH are set.
# Leave blank in local dev so nothing phones home.
PUBLIC_PLAUSIBLE_DOMAIN=
PUBLIC_PLAUSIBLE_SRC=

# Sentry (frontend)
PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0

# ─── Backend (Payload CMS 3 / Next.js 15) ────────────────────────────────────
# >= 32 characters. Generate: `openssl rand -base64 48`
PAYLOAD_SECRET=change-me-generate-a-long-random-value-min-32
# Host names resolve INSIDE the compose network. For apps run on the host use
# `@localhost:5432` instead of `@db:5432`.
DATABASE_URL=postgres://treenweb:treenweb@db:5432/treenweb
# Throwaway DB used by `pnpm --filter @treenweb/backend test:integration`
DATABASE_URL_TEST=postgres://treenweb:treenweb@localhost:5432/treenweb_test
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
# `true` only in local dev — staging/prod use generated migrations
PAYLOAD_DB_PUSH=true
# Allowed browser origins for the CMS API (comma-separated)
CORS_ORIGINS=http://localhost:4321
CSRF_ORIGINS=http://localhost:4321,http://localhost:3000

# Sentry (backend) + sourcemap upload (CI)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ─── PostgreSQL 16 ───────────────────────────────────────────────────────────
POSTGRES_USER=treenweb
POSTGRES_PASSWORD=treenweb
POSTGRES_DB=treenweb

# ─── Traefik / infra (production) ────────────────────────────────────────────
ACME_EMAIL=admin@treenweb.example
SITE_DOMAIN=treenweb.example
CMS_DOMAIN=cms.treenweb.example
TRAEFIK_DASHBOARD_DOMAIN=traefik.treenweb.example

# ─── Object storage (production media uploads) ───────────────────────────────
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
