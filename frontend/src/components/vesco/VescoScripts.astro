---
// Classic (non-module) scripts, load order matters: data -> cs translations ->
// CMS label overrides -> shared runtime -> page controller. Plain global-scope
// JS (window.Vesco), not bundled by Vite — served as-is from public/vesco/js/.
interface Props {
  page: 'home' | 'tarot' | 'horoscope' | 'numerology' | 'dashboard';
  /** { en: {...}, cs: {...} } overrides for vesco-cs.js's UI dictionary, from Payload. */
  cmsLabels?: Record<string, unknown>;
}
const { page, cmsLabels } = Astro.props;
// Safe to embed inside a <script> tag: type="application/json" is inert (never
// executed, so script-src CSP doesn't apply), and `<` is escaped so the JSON
// text can't break out of the tag.
const cmsLabelsJson = cmsLabels ? JSON.stringify(cmsLabels).replace(/</g, '\\u003c') : '{}';
---

<script is:inline src="/vesco/js/vesco-data.js"></script>
<script is:inline src="/vesco/js/vesco-cs.js"></script>
<script is:inline type="application/json" id="vesco-cms-labels" set:html={cmsLabelsJson} />
<script is:inline src="/vesco/js/cms-merge.js"></script>
<script is:inline src="/vesco/js/app.js"></script>
<script is:inline src={`/vesco/js/page-${page}.js`}></script>
