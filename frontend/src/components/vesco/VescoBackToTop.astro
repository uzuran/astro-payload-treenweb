---
import type { VescoLocale } from '../../lib/vescoPath';

interface Props {
  locale: VescoLocale;
}
const { locale } = Astro.props;
const label = locale === 'cs' ? 'Zpět nahoru' : 'Back to top';
---

<button
  id="vesco-back-to-top"
  type="button"
  aria-label={label}
  hidden
  class="fixed bottom-6 right-6 z-40 grid h-12 w-12 place-items-center rounded-full border border-rule bg-card text-ink shadow-[0_10px_28px_-12px_rgba(34,26,19,.4)] transition-colors hover:border-clay hover:text-clay"
>
  <svg
    viewBox="0 0 24 24"
    width="18"
    height="18"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M12 19V6M6 12l6-6 6 6"></path>
  </svg>
</button>

{
  /* External file, not an inline <script>: CSP is script-src 'self' with no
     'unsafe-inline', so inline script content is silently blocked by the
     browser — this was the earlier bug (button never un-hid, since the
     script that would do it never ran). data-astro-rerun: same src on every
     Vesco page, so under View Transitions Astro would otherwise skip
     re-running it on a soft nav — leaving the fresh button on the new page
     with no scroll listener or click handler attached at all. */
}
<script is:inline data-astro-rerun src="/vesco/js/back-to-top.js"></script>
