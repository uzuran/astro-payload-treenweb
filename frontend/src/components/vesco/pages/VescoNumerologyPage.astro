---
import { ClientRouter, fade } from 'astro:transitions';
import VescoCookieConsent from '../VescoCookieConsent.astro';
import VescoFooter from '../VescoFooter.astro';
import VescoHeader, { type VescoLocale } from '../VescoHeader.astro';
import VescoScripts from '../VescoScripts.astro';
import { buildVescoCmsLabels } from '../../../lib/vescoContent';
import '../../../styles/vesco.css';

interface Props {
  locale: VescoLocale;
}
const { locale } = Astro.props;

const cmsLabels = await buildVescoCmsLabels(false);
---

<!doctype html>
<html lang={locale} transition:animate={fade({ duration: '0.2s' })}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Numerology · Vesco</title>
    <meta name="description" content="Vesco — a quieter daily practice: one tarot card, one forecast, one number." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <ClientRouter />
  </head>
  <body class="min-h-screen">
    <VescoHeader active="numerology" locale={locale} />
    <main class="mx-auto max-w-shell px-5 pb-28 pt-16 sm:px-8 lg:px-10">
      <div class="mb-11 border-b border-[--rule] pb-7">
        <p class="v-eyebrow mb-4" data-i18n="numEyebrow"></p>
        <h1 class="m-0 font-display text-[clamp(36px,4.4vw,62px)] font-normal" data-i18n="numTitle"></h1>
      </div>

      <div class="grid gap-8 lg:grid-cols-[minmax(280px,380px)_minmax(320px,1fr)] lg:gap-14">
        <div>
          <form class="v-panel p-8" data-form novalidate>
            <p class="v-label mb-6" data-i18n="yourDetails"></p>
            <label class="mb-2.5 block text-[12px] uppercase tracking-[.1em] text-ink70" for="v-name" data-i18n="fullName"
            ></label>
            <input
              id="v-name"
              name="name"
              class="v-input mb-5"
              value="Anna Marie Vesely"
              placeholder="Anna Marie Vesely"
              autocomplete="name"
            />
            <label class="mb-2.5 block text-[12px] uppercase tracking-[.1em] text-ink70" for="v-dob" data-i18n="dob"
            ></label>
            <input id="v-dob" name="date" type="date" class="v-input v-input--mono mb-6" value="1994-07-19" />
            <button type="submit" class="v-btn v-btn--solid w-full" data-i18n="calculate"></button>
            <p class="mb-0 mt-5 text-[12.5px] leading-relaxed text-muted" data-i18n="numNote"></p>
          </form>

          <section class="v-panel v-panel--plain mt-6 p-8">
            <p class="v-label mb-4" data-i18n="letterValues"></p>
            <div class="flex flex-wrap gap-1.5" data-letters></div>
            <p class="m-0 mt-4 flex flex-wrap gap-5 text-[11px] uppercase tracking-[.1em] text-muted">
              <span class="flex items-center gap-2">
                <svg viewBox="0 0 10 10" width="9" height="9" fill="#A9502F" aria-hidden="true"><rect width="10" height="10" rx="2"></rect></svg>
                <span data-i18n="vowelsSoul"></span>
              </span>
              <span class="flex items-center gap-2">
                <svg viewBox="0 0 10 10" width="9" height="9" fill="none" stroke="#A9502F" aria-hidden="true"
                  ><rect x=".7" y=".7" width="8.6" height="8.6" rx="2"></rect></svg
                >
                <span data-i18n="consonantsPersona"></span>
              </span>
            </p>
          </section>
        </div>

        <div>
          <section
            class="mb-6 grid items-center gap-8 rounded-panel border border-ink bg-[linear-gradient(120deg,#FBF7EF,#F0E5D0)] p-7 sm:p-11 lg:grid-cols-[minmax(150px,200px)_minmax(260px,1fr)] lg:gap-11"
            data-result
          >
          </section>
          <div class="v-stat-grid mb-6" data-blocks></div>
          <section class="v-panel v-panel--plain p-8 sm:p-10">
            <p class="v-label mb-6" data-i18n="breakdown"></p>
            <div data-bars></div>
            <p class="m-0 mt-5 border-t border-[--rule-2] pt-5 text-[13px] leading-relaxed text-ink50">
              <span data-i18n="growthEdge"></span> <span data-growth></span>
            </p>
          </section>
        </div>
      </div>
    </main>
    <VescoFooter />
    <VescoCookieConsent locale={locale} />
    <VescoScripts page="numerology" cmsLabels={cmsLabels} />
  </body>
</html>
