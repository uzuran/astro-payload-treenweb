---
import { ClientRouter, fade } from 'astro:transitions';
import VescoBackToTop from '../VescoBackToTop.astro';
import VescoCookieConsent from '../VescoCookieConsent.astro';
import VescoFooter from '../VescoFooter.astro';
import VescoPreloader from '../VescoPreloader.astro';
import VescoHeader, { type VescoLocale } from '../VescoHeader.astro';
import VescoScripts from '../VescoScripts.astro';
import { buildVescoCmsLabels } from '../../../lib/vescoContent';
import '../../../styles/vesco.css';

interface Props {
  locale: VescoLocale;
}
const { locale } = Astro.props;

const cmsLabels = await buildVescoCmsLabels(false);
---

<!doctype html>
<html lang={locale} transition:animate={fade({ duration: '0.2s' })}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Horoscope · Vesco</title>
    <meta name="description" content="Vesco — a quieter daily practice: one tarot card, one forecast, one number." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <ClientRouter />
  </head>
  <body class="min-h-screen">
    <VescoPreloader />
    <VescoHeader active="horoscope" locale={locale} />
    <main class="mx-auto max-w-shell px-5 pb-28 pt-16 sm:px-8 lg:px-10">
      <div class="mb-11 grid items-end gap-7 border-b border-[--rule] pb-7 sm:grid-cols-[minmax(0,1fr)_auto]">
        <div>
          <p class="v-eyebrow mb-4" data-i18n="horoEyebrow"></p>
          <h1 class="m-0 font-display text-[clamp(36px,4.4vw,62px)] font-normal" data-i18n="horoTitle"></h1>
        </div>
        <div class="v-toggle justify-self-start sm:justify-self-end" data-tabs role="group"></div>
      </div>

      <section
        class="v-panel mb-14 grid gap-8 p-7 sm:p-12 lg:grid-cols-[minmax(110px,150px)_minmax(260px,1fr)_minmax(180px,220px)] lg:gap-13"
        data-featured
      >
      </section>

      <div class="grid gap-5 [grid-template-columns:repeat(auto-fill,minmax(210px,1fr))]" data-signs></div>
    </main>
    <VescoFooter />
    <VescoCookieConsent locale={locale} />
    <VescoBackToTop locale={locale} />
    <VescoScripts page="horoscope" cmsLabels={cmsLabels} />
  </body>
</html>
