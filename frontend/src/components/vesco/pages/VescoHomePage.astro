---
import VescoCookieConsent from '../VescoCookieConsent.astro';
import VescoFooter from '../VescoFooter.astro';
import VescoHeader, { type VescoLocale, vescoPath } from '../VescoHeader.astro';
import VescoScripts from '../VescoScripts.astro';
import { getVescoHero } from '../../../lib/payload/client';
import { buildVescoCmsLabels } from '../../../lib/vescoContent';
import '../../../styles/vesco.css';

interface Props {
  locale: VescoLocale;
}
const { locale } = Astro.props;

const tarotHref = vescoPath(locale, 'tarot');
const numerologyHref = vescoPath(locale, 'numerology');
const horoscopeHref = vescoPath(locale, 'horoscope');
const dashboardHref = vescoPath(locale, 'dashboard');

// Static UI copy (nav, hero, counters, CTA, footer) is CMS-driven via the
// vesco-* globals — edit them in the Payload admin. Fetched for both locales
// and merged client-side over the bundled vesco-cs.js defaults (see
// VescoScripts -> cms-merge.js); app.js picks whichever matches <html lang>.
// Tarot/zodiac/numerology stay bundled JS.
const [cmsLabels, hero] = await Promise.all([
  buildVescoCmsLabels(true),
  getVescoHero(locale).catch(() => null),
]);

const seoTitle = hero?.seo?.title || (locale === 'cs' ? 'Domů · Vesco' : 'Home · Vesco');
const seoDescription =
  hero?.seo?.description ||
  (locale === 'cs'
    ? 'Vesco — tišší denní praxe: jedna tarotová karta, jedna předpověď, jedno číslo.'
    : 'Vesco — a quieter daily practice: one tarot card, one forecast, one number.');
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seoTitle}</title>
    <meta name="description" content={seoDescription} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class="min-h-screen">
    <VescoHeader active="home" locale={locale} />
    <main>
      <section
        class="mx-auto grid max-w-shell items-center gap-8 px-5 pt-16 sm:px-8 lg:grid-cols-[minmax(300px,1.05fr)_minmax(260px,.95fr)] lg:gap-[72px] lg:px-10 lg:pt-[72px]"
      >
        <div>
          <div class="mb-7 flex items-center gap-3.5">
            <span class="h-px w-11 bg-brass"></span>
            <p class="v-eyebrow"><span data-today></span> · <span data-i18n="heroEyebrow"></span></p>
          </div>
          <h1
            class="mb-6 font-display text-[clamp(40px,5.4vw,78px)] font-normal leading-[1.06] tracking-[-.02em]"
            data-hero-title
          >
            A quieter way<br />to read the<br /><span class="text-clay">day ahead</span>
          </h1>
          <p class="mb-9 max-w-[460px] text-[17px] leading-relaxed text-ink70" data-i18n="heroLede"></p>
          <div class="mb-11 flex flex-wrap gap-3.5">
            <a href={tarotHref} class="v-btn v-btn--solid" data-i18n="ctaBegin"></a>
            <a href={numerologyHref} class="v-btn v-btn--ghost" data-i18n="ctaNumbers"></a>
          </div>
          <dl class="flex flex-wrap gap-11 border-t border-[--rule] pt-6">
            <div>
              <dd class="m-0 font-display text-3xl">78</dd>
              <dt class="mt-1 text-[11px] uppercase tracking-label text-muted" data-i18n="statCards"></dt>
            </div>
            <div>
              <dd class="m-0 font-display text-3xl">12</dd>
              <dt class="mt-1 text-[11px] uppercase tracking-label text-muted" data-i18n="statSigns"></dt>
            </div>
            <div>
              <dd class="m-0 font-display text-3xl">6</dd>
              <dt class="mt-1 text-[11px] uppercase tracking-label text-muted" data-i18n="statNumbers"></dt>
            </div>
          </dl>
        </div>

        <div class="relative flex justify-center">
          <span
            class="pointer-events-none absolute top-7 h-[340px] w-[340px] rounded-full border border-[rgba(184,134,59,.5)]"
          ></span>
          <span
            class="pointer-events-none absolute top-[71px] h-[250px] w-[250px] rotate-45 border border-[rgba(169,80,47,.28)]"
          ></span>
          <span
            class="v-anim-drift pointer-events-none absolute left-[4%] top-1.5 h-[90px] w-[90px] bg-[rgba(184,134,59,.16)]"
            style="clip-path:polygon(50% 0,100% 38%,82% 100%,18% 100%,0 38%)"
          ></span>
          <span
            class="v-anim-drift pointer-events-none absolute bottom-11 right-[2%] h-[62px] w-[62px] bg-[rgba(74,93,107,.18)]"
            style="clip-path:polygon(50% 0,100% 50%,50% 100%,0 50%);animation-direction:alternate-reverse"
          ></span>
          <span class="v-anim-twinkle pointer-events-none absolute right-[14%] top-32 h-[5px] w-[5px] bg-brass"></span>
          <figure class="v-anim-fade relative m-0 -rotate-1">
            <img
              src="/vesco/img/cards/nine-wands.jpg"
              alt="Nine of Wands"
              width="336"
              height="487"
              class="v-card-art max-w-[336px] shadow-[0_34px_60px_-34px_rgba(34,26,19,.55)]"
            />
            <figcaption class="mt-4 flex items-baseline justify-between gap-2.5 px-0.5">
              <span class="font-display text-base uppercase tracking-[.14em]" data-daily-name></span>
              <span class="font-mono text-[10px] tracking-label text-muted" data-daily-suit></span>
            </figcaption>
          </figure>
        </div>
      </section>

      <section class="mx-auto max-w-shell px-5 pt-20 sm:px-8 lg:px-10">
        <div class="mb-10 flex items-baseline justify-between gap-5 border-b border-[--rule] pb-4">
          <h2 class="m-0 font-display text-[clamp(26px,2.8vw,38px)] font-normal" data-i18n="todaysCard"></h2>
          <a href={tarotHref} class="flex items-center text-[12px] uppercase tracking-label text-clay hover:text-ink">
            <span data-i18n="openDeck"></span>
            <svg
              viewBox="0 0 16 16"
              width="12"
              height="12"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="ml-2"
              aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"></path></svg
            >
          </a>
        </div>
        <div class="grid gap-8 lg:grid-cols-[minmax(300px,1fr)_minmax(220px,300px)] lg:gap-14">
          <div>
            <div class="mb-5 flex flex-wrap gap-2.5" data-daily-keywords></div>
            <p class="mb-6 font-display text-[27px] leading-snug" data-daily-upright></p>
            <p class="mb-7 max-w-[620px] text-[15px] leading-relaxed text-ink50">
              <span data-i18n="reversedPrefix"></span> <span data-daily-reversed></span>
            </p>
            <div class="flex flex-wrap gap-3">
              <button type="button" class="v-btn v-btn--outline" data-save-daily></button>
              <a href={dashboardHref} class="v-btn text-muted hover:text-ink" data-i18n="addNote"></a>
            </div>
          </div>
          <aside class="v-panel p-7">
            <p class="v-label mb-4" data-i18n="cardRecord"></p>
            <dl class="m-0" data-daily-record></dl>
          </aside>
        </div>
      </section>

      <section class="mx-auto max-w-shell px-5 pt-20 sm:px-8 lg:px-10">
        <div class="mb-10 flex items-baseline justify-between gap-5 border-b border-[--rule] pb-4">
          <h2 class="m-0 font-display text-[clamp(26px,2.8vw,38px)] font-normal" data-i18n="skyToday"></h2>
          <a
            href={horoscopeHref}
            class="flex items-center text-[12px] uppercase tracking-label text-clay hover:text-ink"
          >
            <span data-i18n="allSigns"></span>
            <svg
              viewBox="0 0 16 16"
              width="12"
              height="12"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="ml-2"
              aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"></path></svg
            >
          </a>
        </div>
        <div class="grid gap-6 [grid-template-columns:repeat(auto-fit,minmax(320px,1fr))]">
          <article class="v-panel flex flex-wrap gap-8 p-10" data-sky-card></article>
          <aside class="v-panel v-panel--plain p-8">
            <p class="v-label mb-5" data-i18n="transitsInPlay"></p>
            <ul class="m-0 list-none p-0" data-transits></ul>
          </aside>
        </div>
      </section>

      <section class="mx-auto max-w-shell px-5 pt-20 sm:px-8 lg:px-10">
        <div
          class="grid items-center gap-8 rounded-panel border border-[--rule] bg-[linear-gradient(100deg,#FBF7EF_40%,#F1E7D3)] p-8 sm:p-12 lg:grid-cols-[minmax(140px,190px)_minmax(240px,1fr)_auto] lg:gap-12"
        >
          <p class="m-0 text-center">
            <span class="block font-display text-[clamp(68px,8vw,116px)] leading-[.9] text-clay" data-teaser-num></span>
            <span class="mt-4 block font-mono text-[10px] uppercase tracking-[.2em] text-muted" data-i18n="lifePath"
            ></span>
          </p>
          <div>
            <p class="v-label mb-3" data-i18n="numerologySection"></p>
            <h3 class="mb-3.5 font-display text-[clamp(24px,2.6vw,34px)] font-normal" data-teaser-title></h3>
            <p class="m-0 max-w-[520px] text-[15px] leading-relaxed text-ink70" data-teaser-line></p>
          </div>
          <a href={numerologyHref} class="v-btn v-btn--solid" data-i18n="calcMine"></a>
        </div>
      </section>

      <section class="mx-auto max-w-shell px-5 pb-28 pt-20 sm:px-8 lg:px-10">
        <div class="grid items-end gap-10 border-t border-ink pt-12 lg:grid-cols-[minmax(300px,1fr)_auto]">
          <div>
            <h3 class="mb-4 font-display text-[clamp(30px,3.6vw,52px)] font-normal leading-tight" data-cta-title></h3>
            <p class="m-0 max-w-[520px] text-base leading-relaxed text-ink70" data-i18n="ctaBody"></p>
          </div>
          <div>
            <div class="mb-5 flex justify-end gap-2" data-streak-week></div>
            <p class="m-0 flex items-baseline justify-end gap-3">
              <span class="font-display text-[44px]" data-streak-days></span>
              <span class="text-[12px] uppercase tracking-label text-muted" data-i18n="dayStreak"></span>
            </p>
          </div>
        </div>
      </section>
    </main>
    <VescoFooter />
    <VescoCookieConsent locale={locale} />
    <VescoScripts page="home" cmsLabels={cmsLabels} />
  </body>
</html>
