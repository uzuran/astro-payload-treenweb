---
import VescoLogo from './VescoLogo.astro';
import { vescoPath, type VescoLocale, type VescoPage } from '../../lib/vescoPath';

// Re-exported so existing `import { type VescoLocale, vescoPath } from
// './VescoHeader.astro'` call sites keep working. The real definition lives
// in lib/vescoPath.ts (a plain module, unlike this file, vitest can import
// and test directly) — it used to live inline here as an exported frontmatter
// function, which silently broke: Astro hoists exported bindings above the
// component closure, so it lost access to a non-exported sibling const.
export type { VescoLocale, VescoPage };
export { vescoPath };

interface Props {
  active: VescoPage;
  locale: VescoLocale;
}
const { active, locale } = Astro.props;

const links: { id: VescoPage; i18n: string; label: string }[] = [
  { id: 'home', i18n: 'nav.home', label: 'Home' },
  { id: 'tarot', i18n: 'nav.tarot', label: 'Tarot' },
  { id: 'horoscope', i18n: 'nav.horoscope', label: 'Horoscope' },
  { id: 'numerology', i18n: 'nav.numerology', label: 'Numerology' },
  { id: 'dashboard', i18n: 'nav.dashboard', label: 'Dashboard' },
];
---

<header class="sticky top-0 z-40 border-b border-[--rule] bg-[rgba(244,237,224,.9)] backdrop-blur">
  <div
    class="mx-auto flex max-w-shell flex-wrap items-center justify-between gap-x-6 gap-y-1 px-5 py-3 sm:px-8 lg:px-10"
    style="min-height:92px"
  >
    <a href={vescoPath(locale, 'home')} class="flex items-center gap-2.5 whitespace-nowrap text-ink hover:text-ink">
      <VescoLogo size={56} />
      <span class="font-display text-[32px] tracking-logo">VESCO</span>
      <span
        class="hidden font-mono text-[10px] uppercase tracking-wide2 text-muted sm:inline"
        data-i18n="est"
      >
        est. mmxxvi
      </span>
    </a>

    <button
      id="vesco-nav-toggle"
      type="button"
      class="grid h-11 w-11 shrink-0 place-items-center rounded-full border border-rule text-ink lg:hidden"
      aria-expanded="false"
      aria-controls="vesco-nav"
      aria-label="Menu"
    >
      <svg
        id="vesco-nav-icon-open"
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
      <svg
        id="vesco-nav-icon-close"
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        class="hidden"
        aria-hidden="true"
      >
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>

    <nav
      id="vesco-nav"
      class="hidden w-full flex-col items-stretch gap-1 pb-3 lg:flex lg:w-auto lg:flex-row lg:items-center lg:gap-x-6 lg:gap-y-3 lg:pb-0"
    >
      {
        links.map((link) => (
          <a
            href={vescoPath(locale, link.id)}
            class="v-nav-link block border-b border-[--rule-2] py-3 text-center lg:inline lg:border-b-0 lg:py-0 lg:text-left"
            aria-current={link.id === active ? 'page' : undefined}
            data-i18n={link.i18n}
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={vescoPath(locale, 'tarot')}
        class="v-btn v-btn--solid v-btn--sm mt-3 w-full justify-center lg:mt-0 lg:w-auto"
        data-i18n="pullCard"
      >
        Pull a card
      </a>
      <div class="v-toggle mt-3 self-center lg:mt-0 lg:self-auto">
        <a href={vescoPath('en', active)} class="font-mono" aria-pressed={locale === 'en' ? 'true' : 'false'}>EN</a>
        <a href={vescoPath('cs', active)} class="font-mono" aria-pressed={locale === 'cs' ? 'true' : 'false'}>CS</a>
      </div>
    </nav>
  </div>
</header>

{
  /* External file (CSP: script-src 'self', no 'unsafe-inline' — see the
     back-to-top fix for why this can't be an inline block). data-astro-rerun:
     same src on every Vesco page, so View Transitions would otherwise skip
     re-running it after the first soft nav, leaving the fresh menu on the
     next page with no click handler and a stale open/closed icon state. */
}
<script is:inline data-astro-rerun src="/vesco/js/nav-toggle.js"></script>
