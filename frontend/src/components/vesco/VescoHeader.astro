---
import VescoLogo from './VescoLogo.astro';

interface Props {
  active: 'home' | 'tarot' | 'horoscope' | 'numerology' | 'dashboard';
}
const { active } = Astro.props;

const links: { id: Props['active']; href: string; i18n: string; label: string }[] = [
  { id: 'home', href: '/', i18n: 'nav.home', label: 'Home' },
  { id: 'tarot', href: '/tarot', i18n: 'nav.tarot', label: 'Tarot' },
  { id: 'horoscope', href: '/horoscope', i18n: 'nav.horoscope', label: 'Horoscope' },
  { id: 'numerology', href: '/numerology', i18n: 'nav.numerology', label: 'Numerology' },
  { id: 'dashboard', href: '/dashboard', i18n: 'nav.dashboard', label: 'Dashboard' },
];
---

<header class="sticky top-0 z-40 border-b border-[--rule] bg-[rgba(244,237,224,.9)] backdrop-blur">
  <div
    class="mx-auto flex max-w-shell flex-wrap items-center justify-between gap-x-6 gap-y-4 px-5 py-3 sm:px-8 lg:px-10"
    style="min-height:92px"
  >
    <a href="/" class="flex items-center gap-2.5 whitespace-nowrap text-ink hover:text-ink">
      <VescoLogo size={56} />
      <span class="font-display text-[32px] tracking-logo">VESCO</span>
      <span class="font-mono text-[10px] uppercase tracking-wide2 text-muted" data-i18n="est">est. mmxxvi</span>
    </a>
    <nav class="flex flex-wrap items-center gap-x-6 gap-y-3">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="v-nav-link"
            aria-current={link.id === active ? 'page' : undefined}
            data-i18n={link.i18n}
          >
            {link.label}
          </a>
        ))
      }
      <a href="/tarot" class="v-btn v-btn--solid v-btn--sm" data-i18n="pullCard">Pull a card</a>
      <div class="v-toggle">
        <button type="button" class="font-mono" data-lang-btn="en" aria-pressed="true">EN</button>
        <button type="button" class="font-mono" data-lang-btn="cs" aria-pressed="false">CS</button>
      </div>
    </nav>
  </div>
</header>
