---
import { NAV_FB, SITE_FB } from '../lib/fallback';
import { aria } from '../lib/i18n/aria';
import type { Labels } from '../lib/i18n/labels';
import { type Locale, localizedPath } from '../lib/locale';
import type { NavItem, SiteSettings } from '../lib/payload/client';
import LocaleSwitcher from './LocaleSwitcher.astro';

interface Props {
  siteName?: string | null;
  items?: NavItem[] | null;
  locale: Locale;
  supportedLocales?: SiteSettings['supportedLocales'];
  labels: Labels;
}

const { siteName, locale, supportedLocales, labels } = Astro.props;
const name = siteName || SITE_FB.siteName || '';
const ariaFor = aria(locale);
const home = localizedPath(locale, '/');

// Hash links (#about, #booking) only resolve on the home page — prefix them so
// they also work from a content page (/en/foo -> /en/#about).
const resolveHref = (href: string) => (href.startsWith('#') ? `${home}${href}` : href);
const links = (Astro.props.items?.length ? Astro.props.items : NAV_FB).map((link) => ({
  label: link.label,
  href: resolveHref(link.href),
}));
---

<header class="border-b border-white/15">
  <div class="wrap flex items-center justify-between gap-6 py-6">
    <a class="logo" href={home} aria-label={ariaFor('homeAria', { site: name })}
      >{name}<span>®</span></a
    >

    <nav class="hidden gap-8 text-sm md:flex" aria-label={ariaFor('navAria')}>
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>

    <LocaleSwitcher
      locale={locale}
      supportedLocales={supportedLocales}
      class="ml-auto hidden md:flex"
    />

    <a href={resolveHref('#booking')} class="small-cta">{labels.header.cta} <span>↗</span></a>

    <button
      id="menu-toggle"
      class="text-2xl md:hidden"
      aria-label={ariaFor('menuOpen')}
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-label-open={ariaFor('menuOpen')}
      data-label-close={ariaFor('menuClose')}
    >
      ☰
    </button>
  </div>

  <nav id="mobile-menu" class="wrap flex-col gap-4 pb-6" hidden aria-label={ariaFor('navAriaMobile')}>
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
    <LocaleSwitcher locale={locale} supportedLocales={supportedLocales} class="pt-2" />
  </nav>
</header>

<script>
  const toggle = document.querySelector('#menu-toggle');
  const menu = document.querySelector('#mobile-menu');

  if (toggle instanceof HTMLElement && menu instanceof HTMLElement) {
    const labelOpen = toggle.dataset.labelOpen ?? 'Open menu';
    const labelClose = toggle.dataset.labelClose ?? 'Close menu';

    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      toggle.setAttribute('aria-label', open ? labelOpen : labelClose);
      menu.hidden = open;
    });

    menu.querySelectorAll('a').forEach((link) =>
      link.addEventListener('click', () => {
        menu.hidden = true;
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', labelOpen);
      }),
    );
  }
</script>
