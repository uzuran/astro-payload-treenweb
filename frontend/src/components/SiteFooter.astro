---
import { getFallback } from '../lib/fallback';
import { aria } from '../lib/i18n/aria';
import type { Labels } from '../lib/i18n/labels';
import { DEFAULT_LOCALE, type Locale } from '../lib/locale';
import { resolveNavHref } from '../lib/nav';
import type { NavItem, SiteSettings } from '../lib/payload/client';
import { socialIcon } from '../lib/social';
import Multiline from './Multiline.astro';

interface Props {
  site?: SiteSettings | null;
  labels: Labels;
  /** Navigation.footer — a secondary link row; hidden when empty. */
  footerItems?: NavItem[] | null;
  locale?: Locale;
}

const { labels, locale = DEFAULT_LOCALE } = Astro.props;
const fbSite = getFallback(locale).site;
const site = Astro.props.site ?? {};
const name = site.siteName || fbSite.siteName;
const tagline = site.tagline || fbSite.tagline;
const contact = { ...fbSite.contact, ...(site.contact ?? {}) };
const footerNote = site.footerNote || fbSite.footerNote;

const footerLinks = (Astro.props.footerItems ?? []).map((link) => ({
  label: link.label,
  href: resolveNavHref(link.href, locale),
}));

const socials = (site.social ?? [])
  .filter((s) => s.url)
  .map((s) => ({ url: s.url, icon: socialIcon(s.platform) }));
---

<footer id="contacts" class="border-t border-white/15">
  <div class="wrap grid gap-8 py-12 sm:grid-cols-3">
    <div>
      <a href="#" class="logo">{name}<span>®</span></a>
      <p class="muted mt-3 text-sm">{tagline}</p>
    </div>

    <div>
      <p class="eyebrow orange mb-3">{labels.footer.findUsHeading}</p>
      <p><Multiline text={contact.address} /></p>
      {contact.phone && <p class="mt-2">{contact.phone}</p>}
    </div>

    <div>
      <p class="eyebrow orange mb-3">{labels.footer.hoursHeading}</p>
      {contact.hoursWeekday && <p>{contact.hoursWeekday}</p>}
      <p class="muted mt-2">
        {contact.hoursSaturday}
        {contact.hoursSaturday && contact.hoursSunday && ' / '}
        {contact.hoursSunday}
      </p>
    </div>
  </div>

  {
    socials.length > 0 && (
      <ul class="wrap flex flex-wrap gap-4 border-t border-white/15 py-5">
        {socials.map(({ url, icon }) => (
          <li>
            <a
              href={url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={icon.label}
              class="inline-flex text-white/60 transition-colors hover:text-orange"
            >
              <svg
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="currentColor"
                aria-hidden="true"
                focusable="false"
              >
                <path d={icon.path} />
              </svg>
            </a>
          </li>
        ))}
      </ul>
    )
  }

  {
    footerLinks.length > 0 && (
      <nav
        class="wrap flex flex-wrap gap-x-6 gap-y-2 border-t border-white/15 py-5 text-xs text-white/60"
        aria-label={aria(locale)('navAriaFooter')}
      >
        {footerLinks.map((link) => (
          <a href={link.href} class="hover:text-orange">
            {link.label}
          </a>
        ))}
      </nav>
    )
  }

  <div
    class="wrap flex flex-wrap justify-between gap-3 border-t border-white/15 py-5 text-xs text-white/40"
  >
    <span>{footerNote}</span>
    <span>{labels.footer.disclaimer}</span>
  </div>
</footer>
