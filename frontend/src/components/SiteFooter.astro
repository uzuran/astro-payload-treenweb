---
import { SITE_FB } from '../lib/fallback';
import type { Labels } from '../lib/i18n/labels';
import type { SiteSettings } from '../lib/payload/client';
import Multiline from './Multiline.astro';

interface Props {
  site?: SiteSettings | null;
  labels: Labels;
}

const { labels } = Astro.props;
const site = Astro.props.site ?? {};
const name = site.siteName || SITE_FB.siteName;
const tagline = site.tagline || SITE_FB.tagline;
const contact = { ...SITE_FB.contact, ...(site.contact ?? {}) };
const footerNote = site.footerNote || SITE_FB.footerNote;
---

<footer id="contacts" class="border-t border-white/15">
  <div class="wrap grid gap-8 py-12 sm:grid-cols-3">
    <div>
      <a href="#" class="logo">{name}<span>®</span></a>
      <p class="muted mt-3 text-sm">{tagline}</p>
    </div>

    <div>
      <p class="eyebrow orange mb-3">{labels.footer.findUsHeading}</p>
      <p><Multiline text={contact.address} /></p>
      {contact.phone && <p class="mt-2">{contact.phone}</p>}
    </div>

    <div>
      <p class="eyebrow orange mb-3">{labels.footer.hoursHeading}</p>
      {contact.hoursWeekday && <p>{contact.hoursWeekday}</p>}
      <p class="muted mt-2">
        {contact.hoursSaturday}
        {contact.hoursSaturday && contact.hoursSunday && ' / '}
        {contact.hoursSunday}
      </p>
    </div>
  </div>

  <div
    class="wrap flex flex-wrap justify-between gap-3 border-t border-white/15 py-5 text-xs text-white/40"
  >
    <span>{footerNote}</span>
    <span>{labels.footer.disclaimer}</span>
  </div>
</footer>
