---
import { getFallback } from '../../lib/fallback';
import { DEFAULT_LOCALE, type Locale } from '../../lib/locale';

interface Props {
  words?: string[] | null;
  locale?: Locale;
}

const source = Astro.props.words?.length
  ? Astro.props.words
  : getFallback(Astro.props.locale ?? DEFAULT_LOCALE).ticker;
// The template repeats the set so the row fills wide viewports.
const words = [...source, ...source];
---

<div class="ticker" aria-hidden="true">
  {
    words.map((word, i) => (
      <Fragment>
        {i > 0 && <span>✳</span>} {word}{' '}
      </Fragment>
    ))
  }
</div>
