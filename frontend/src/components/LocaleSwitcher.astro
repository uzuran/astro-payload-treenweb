---
import { LOCALE_LABELS, isLocale, localizedPath, stripLocale, type Locale } from '../lib/locale';
import type { SiteSettings } from '../lib/payload/client';

interface Props {
  /** The locale currently being rendered. */
  locale: Locale;
  /** From SiteSettings — the offered set; disabled entries are dropped. */
  supportedLocales?: SiteSettings['supportedLocales'];
  class?: string;
}

const { locale, supportedLocales, class: className } = Astro.props;

const options = (supportedLocales ?? [])
  .filter((entry) => entry.enabled !== false && isLocale(entry.code))
  .map((entry) => {
    const code = entry.code as Locale;
    return { code, label: entry.label || LOCALE_LABELS[code] };
  });

// Same page, other locale: strip the current /<locale> prefix, re-add the target's.
const basePath = stripLocale(Astro.url.pathname);
const search = Astro.url.search;
---

{
  options.length > 1 && (
    <nav
      class:list={['flex items-center gap-3 text-sm tracking-wide', className]}
      aria-label="Язык / Language"
    >
      {options.map(({ code, label }) => (
        <a
          href={localizedPath(code, basePath) + search}
          hreflang={code}
          lang={code}
          aria-current={code === locale ? 'true' : undefined}
          class="uppercase hover:text-orange aria-[current]:font-bold aria-[current]:text-orange"
        >
          {code}
          <span class="sr-only"> — {label}</span>
        </a>
      ))}
    </nav>
  )
}
