---
import RichText from '../components/RichText.astro';
import { env } from '../env';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPageBySlug } from '../lib/payload/client';
import { buildMeta } from '../lib/seo/buildMeta';
import { organizationJsonLd, webPageJsonLd } from '../lib/seo/jsonLd';

let page = null;
try {
  page = await getPageBySlug('home');
} catch (error) {
  console.error('[index] failed to load home page:', error);
}
if (!page) {
  Astro.response.status = 503;
}

const meta = buildMeta(
  {
    title: page?.seo?.title ?? page?.title ?? 'Home',
    description: page?.seo?.description,
    path: '/',
    noindex: page?.seo?.noindex ?? false,
  },
  env.PUBLIC_SITE_URL,
);
---

<BaseLayout
  meta={meta}
  jsonLd={[
    organizationJsonLd(env.PUBLIC_SITE_URL),
    webPageJsonLd({ title: meta.title, description: meta.description, url: meta.canonical }),
  ]}
>
  {
    page ? (
      <main>
        <h1>{page.title}</h1>
        <RichText content={page.content} />
      </main>
    ) : (
      <main>
        <h1>treenweb</h1>
        <p>The home page has not been published yet.</p>
      </main>
    )
  }
</BaseLayout>
