---
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import About from '../../components/sections/About.astro';
import Booking from '../../components/sections/Booking.astro';
import Hero from '../../components/sections/Hero.astro';
import Services from '../../components/sections/Services.astro';
import Team from '../../components/sections/Team.astro';
import Ticker from '../../components/sections/Ticker.astro';
import { env } from '../../env';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isLocale, localizedPath, type Locale } from '../../lib/locale';
import {
  getAbout,
  getBooking,
  getHero,
  getNavigation,
  getPageBySlug,
  getServices,
  getSiteSettings,
  getTeam,
  listMasters,
  mediaUrl,
} from '../../lib/payload/client';
import { buildMeta, type Alternate } from '../../lib/seo/buildMeta';
import { organizationJsonLd, webPageJsonLd } from '../../lib/seo/jsonLd';

/** Resolve a fetch, logging and swallowing failures so one dead section never 500s the page. */
const settle = <T,>(promise: Promise<T>, label: string): Promise<T | null> =>
  promise.catch((error: unknown) => {
    console.error(`[index] ${label} failed:`, error);
    return null;
  });

const locale = Astro.locals.locale;

const [page, hero, services, about, team, booking, navigation, siteSettings, masters] =
  await Promise.all([
    settle(getPageBySlug('home', locale), 'home page'),
    settle(getHero(locale), 'hero'),
    settle(getServices(locale), 'services'),
    settle(getAbout(locale), 'about'),
    settle(getTeam(locale), 'team'),
    settle(getBooking(locale), 'booking'),
    settle(getNavigation(locale), 'navigation'),
    settle(getSiteSettings(locale), 'site settings'),
    settle(listMasters(locale), 'masters'),
  ]);

const siteName = siteSettings?.siteName || 'FORMA';

// hreflang: one link per enabled locale + x-default, only when >1 is offered.
const enabledLocales: Locale[] = (siteSettings?.supportedLocales ?? [])
  .filter((l) => l.enabled !== false)
  .map((l) => l.code)
  .filter(isLocale);
const abs = (path: string) => new URL(path, env.PUBLIC_SITE_URL).href;
const alternates: Alternate[] =
  enabledLocales.length > 1
    ? [
        ...enabledLocales.map((code) => ({
          hreflang: code,
          href: abs(localizedPath(code, '/')),
        })),
        { hreflang: 'x-default', href: abs(localizedPath('ru', '/')) },
      ]
    : [];

const meta = buildMeta(
  {
    title: page?.seo?.title || page?.title || `${siteName} — барбершоп`,
    description: page?.seo?.description || siteSettings?.description,
    path: localizedPath(locale, '/'),
    noindex: page?.seo?.noindex ?? false,
    image: mediaUrl(siteSettings?.ogImage) ?? undefined,
    siteName,
    locale,
    alternates,
  },
  env.PUBLIC_SITE_URL,
);
---

<BaseLayout
  meta={meta}
  lang={locale}
  jsonLd={[
    organizationJsonLd(env.PUBLIC_SITE_URL),
    webPageJsonLd({ title: meta.title, description: meta.description, url: meta.canonical }),
  ]}
>
  <SiteHeader
    siteName={siteSettings?.siteName}
    items={navigation?.main}
    locale={locale}
    supportedLocales={siteSettings?.supportedLocales}
  />
  <main>
    <Hero data={hero} />
    <Ticker words={siteSettings?.ticker?.map((t) => t.word)} />
    <Services data={services} />
    <About data={about} />
    <Team data={team} masters={masters} />
    <Booking data={booking} services={services} masters={masters} />
  </main>
  <SiteFooter site={siteSettings} />
</BaseLayout>
