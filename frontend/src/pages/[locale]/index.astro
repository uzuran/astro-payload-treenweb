---
import RichText from '../../components/RichText.astro';
import { env } from '../../env';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getFallback } from '../../lib/fallback';
import { getPageBySlug, getSiteSettings } from '../../lib/payload/client';
import { buildMeta } from '../../lib/seo/buildMeta';
import { organizationJsonLd, webPageJsonLd } from '../../lib/seo/jsonLd';

// Placeholder homepage. Content is CMS-driven: create a Page with slug "home"
// in the Payload admin and it renders here. A template replaces this file with
// its own composition of sections.

const locale = Astro.locals.locale;

let page = null;
try {
  page = await getPageBySlug('home', locale);
} catch (error) {
  console.error(`[home] failed to load "home" (${locale}):`, error);
}

let siteSettings = null;
try {
  siteSettings = await getSiteSettings(locale);
} catch (error) {
  console.error(`[home] site settings failed (${locale}):`, error);
}

const siteName = siteSettings?.siteName || getFallback(locale).site.siteName || '';

const meta = buildMeta(
  {
    title: page?.seo?.title ?? page?.title ?? siteName,
    description:
      page?.seo?.description ??
      siteSettings?.seo?.defaultDescription ??
      siteSettings?.description ??
      undefined,
    titleTemplate: siteSettings?.seo?.titleTemplate,
    path: '/',
    noindex: page?.seo?.noindex ?? false,
    locale,
    siteName,
  },
  env.PUBLIC_SITE_URL,
);

const jsonLd = [
  organizationJsonLd(env.PUBLIC_SITE_URL, siteName),
  webPageJsonLd({ title: meta.title, description: meta.description, url: meta.canonical }),
];
---

<SiteLayout meta={meta} locale={locale} jsonLd={jsonLd}>
  {
    page?.content ? (
      <article class="prose mx-auto max-w-3xl px-4 py-16">
        <h1>{page.title}</h1>
        <RichText content={page.content} />
      </article>
    ) : (
      <section class="mx-auto max-w-3xl px-4 py-24 text-center">
        <h1 class="text-2xl font-semibold">{siteName || 'treenweb'}</h1>
        <p class="mt-4 opacity-70">
          No homepage content yet. Create a page with slug <code>home</code> in the CMS.
        </p>
      </section>
    )
  }
</SiteLayout>
