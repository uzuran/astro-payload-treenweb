---
import RichText from '../../components/RichText.astro';
import About from '../../components/sections/About.astro';
import Hero from '../../components/sections/Hero.astro';
import Services from '../../components/sections/Services.astro';
import { env } from '../../env';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getFallback } from '../../lib/fallback';
import {
  getAbout,
  getAnimationSettings,
  getHero,
  getPageBySlug,
  getServices,
  getSiteSettings,
} from '../../lib/payload/client';
import { buildMeta } from '../../lib/seo/buildMeta';
import { organizationJsonLd, webPageJsonLd } from '../../lib/seo/jsonLd';

// Homepage. Section content (Hero / About / Services) is CMS-driven via the
// globals of the same name — edit them in the Payload admin. Falls back to a
// Page with slug "home" (for simple rich-text homepages), then a placeholder.

/** Resolve a fetch, logging and swallowing failures so one dead section never 500s the page. */
const settle = <T,>(promise: Promise<T>, label: string): Promise<T | null> =>
  promise.catch((error: unknown) => {
    console.error(`[home] ${label} failed:`, error);
    return null;
  });

const locale = Astro.locals.locale;

const [siteSettings, hero, about, services, page, animationSettings] = await Promise.all([
  settle(getSiteSettings(locale), 'site settings'),
  settle(getHero(locale), 'hero'),
  settle(getAbout(locale), 'about'),
  settle(getServices(locale), 'services'),
  settle(getPageBySlug('home', locale), 'page'),
  settle(getAnimationSettings(locale), 'animation settings'),
]);

const hasSections = Boolean(hero?.heading || about?.heading || services?.items?.length);
const siteName = siteSettings?.siteName || getFallback(locale).site.siteName || '';

// Editor-facing placeholder for an empty homepage — was hardcoded English
// regardless of locale; now keyed per locale like the rest of the chrome.
const emptyStateNote: Record<typeof locale, string> = {
  ru: 'На главной пока нет контента. Заполните глобал Hero или создайте страницу со слагом home в CMS.',
  en: 'No homepage content yet. Fill in the Hero global, or create a page with slug home, in the CMS.',
  cs: 'Domovská stránka zatím nemá obsah. Vyplňte globál Hero, nebo vytvořte stránku se slugem home v CMS.',
};

const meta = buildMeta(
  {
    title: page?.seo?.title ?? hero?.heading ?? siteName,
    description:
      page?.seo?.description ??
      hero?.intro ??
      siteSettings?.seo?.defaultDescription ??
      siteSettings?.description ??
      undefined,
    titleTemplate: siteSettings?.seo?.titleTemplate,
    path: '/',
    noindex: page?.seo?.noindex ?? false,
    locale,
    siteName,
  },
  env.PUBLIC_SITE_URL,
);

const jsonLd = [
  organizationJsonLd(env.PUBLIC_SITE_URL, siteName),
  webPageJsonLd({ title: meta.title, description: meta.description, url: meta.canonical }),
];
---

<SiteLayout meta={meta} locale={locale} jsonLd={jsonLd}>
  {
    hasSections ? (
      <>
        <Hero hero={hero} animation={siteSettings?.heroAnimation} duration={animationSettings?.duration} />
        <About about={about} />
        <Services services={services} />
      </>
    ) : page?.content ? (
      <article class="prose mx-auto max-w-3xl px-4 py-16">
        <h1>{page.title}</h1>
        <RichText content={page.content} />
      </article>
    ) : (
      <section class="mx-auto max-w-3xl px-4 py-24 text-center">
        <h1 class="text-2xl font-semibold">{siteName || 'treenweb'}</h1>
        <p class="mt-4 opacity-70">{emptyStateNote[locale]}</p>
      </section>
    )
  }
</SiteLayout>
