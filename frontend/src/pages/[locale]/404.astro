---
import { env } from '../../env';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { t } from '../../lib/i18n/ui';
import { localizedPath } from '../../lib/locale';
import { buildMeta } from '../../lib/seo/buildMeta';

const locale = Astro.locals.locale;
const tr = t(locale);
const home = localizedPath(locale, '/');
const meta = buildMeta(
  { title: tr('errors.pageNotFoundTitle'), path: localizedPath(locale, '/404'), noindex: true, locale },
  env.PUBLIC_SITE_URL,
);
---

<SiteLayout meta={meta} locale={locale}>
  <div class="wrap section">
    <h1>{tr('errors.notFound404Heading')}</h1>
    <p class="muted mt-4">{tr('errors.notFoundBody')}</p>
    <a class="button mt-8" href={home}>{tr('errors.backHome')}</a>
  </div>
</SiteLayout>
