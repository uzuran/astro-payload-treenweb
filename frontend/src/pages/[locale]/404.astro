---
import { env } from '../../env';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { SITE_FB } from '../../lib/fallback';
import { resolveLabels } from '../../lib/i18n/labels';
import { localizedPath } from '../../lib/locale';
import { getSiteSettings, getUiLabels } from '../../lib/payload/client';
import { buildMeta } from '../../lib/seo/buildMeta';

const locale = Astro.locals.locale;
const home = localizedPath(locale, '/');

let siteSettings = null;
try {
  siteSettings = await getSiteSettings(locale);
} catch (error) {
  console.error(`[404] site settings failed (${locale}):`, error);
}
let uiLabels = null;
try {
  uiLabels = await getUiLabels(locale);
} catch (error) {
  console.error(`[404] ui labels failed (${locale}):`, error);
}
const siteName = siteSettings?.siteName || SITE_FB.siteName || '';
const labels = resolveLabels(uiLabels, locale);

const meta = buildMeta(
  {
    title: labels.notFound.pageMetaTitle,
    path: localizedPath(locale, '/404'),
    noindex: true,
    locale,
    siteName,
    titleTemplate: siteSettings?.seo?.titleTemplate,
  },
  env.PUBLIC_SITE_URL,
);
---

<SiteLayout meta={meta} locale={locale} siteSettings={siteSettings} uiLabels={uiLabels}>
  <div class="wrap section">
    <h1>{labels.notFound.heading404}</h1>
    <p class="muted mt-4">{labels.notFound.body}</p>
    <a class="button mt-8" href={home}>{labels.notFound.backHomeLabel}</a>
  </div>
</SiteLayout>
