---
import RichText from '../../../components/RichText.astro';
import { env } from '../../../env';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { SITE_FB } from '../../../lib/fallback';
import { resolveLabels } from '../../../lib/i18n/labels';
import { localizedPath } from '../../../lib/locale';
import { getPostBySlug, getSiteSettings, getUiLabels } from '../../../lib/payload/client';
import { buildMeta } from '../../../lib/seo/buildMeta';
import { articleJsonLd, breadcrumbJsonLd } from '../../../lib/seo/jsonLd';

const locale = Astro.locals.locale;
const slug = (Astro.params.slug ?? '').replace(/^\/+|\/+$/g, '');
const path = localizedPath(locale, `/posts/${slug}`);
const home = localizedPath(locale, '/');

let post = null;
try {
  post = slug ? await getPostBySlug(slug, locale) : null;
} catch (error) {
  console.error(`[post] failed to load "${slug}" (${locale}):`, error);
}
if (!post) {
  Astro.response.status = 404;
}

let siteSettings = null;
try {
  siteSettings = await getSiteSettings(locale);
} catch (error) {
  console.error(`[post] site settings failed (${locale}):`, error);
}
let uiLabels = null;
try {
  uiLabels = await getUiLabels(locale);
} catch (error) {
  console.error(`[post] ui labels failed (${locale}):`, error);
}
const siteName = siteSettings?.siteName || SITE_FB.siteName || '';
const labels = resolveLabels(uiLabels, locale);

const meta = buildMeta(
  post
    ? {
        title: post.seo?.title ?? post.title,
        description:
          post.seo?.description ??
          post.excerpt ??
          siteSettings?.seo?.defaultDescription ??
          siteSettings?.description ??
          undefined,
        titleTemplate: siteSettings?.seo?.titleTemplate,
        path,
        noindex: post.seo?.noindex ?? false,
        type: 'article',
        locale,
        siteName,
      }
    : {
        title: labels.notFound.postMetaTitle,
        path,
        noindex: true,
        locale,
        siteName,
        titleTemplate: siteSettings?.seo?.titleTemplate,
      },
  env.PUBLIC_SITE_URL,
);

const jsonLd = post
  ? [
      articleJsonLd({
        title: meta.title,
        description: meta.description,
        url: meta.canonical,
        datePublished: post.publishedAt,
        dateModified: post.updatedAt,
      }),
      breadcrumbJsonLd([
        { name: siteName, url: new URL(home, env.PUBLIC_SITE_URL).href },
        { name: post.title, url: meta.canonical },
      ]),
    ]
  : [];
---

<SiteLayout meta={meta} locale={locale} siteSettings={siteSettings} uiLabels={uiLabels} jsonLd={jsonLd}>
  {
    post ? (
      <article class="wrap section">
        <h1>{post.title}</h1>
        {post.excerpt && <p class="muted mt-4">{post.excerpt}</p>}
        <RichText content={post.content} />
      </article>
    ) : (
      <div class="wrap section">
        <h1>{labels.notFound.postHeading}</h1>
        <a class="button mt-8" href={home}>{labels.notFound.backHomeLabel}</a>
      </div>
    )
  }
</SiteLayout>
