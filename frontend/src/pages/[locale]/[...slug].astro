---
import RichText from '../../components/RichText.astro';
import { env } from '../../env';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getFallback } from '../../lib/fallback';
import { resolveLabels } from '../../lib/i18n/labels';
import { localizedPath } from '../../lib/locale';
import { getPageBySlug, getSiteSettings, getUiLabels } from '../../lib/payload/client';
import { buildMeta } from '../../lib/seo/buildMeta';
import { breadcrumbJsonLd, webPageJsonLd } from '../../lib/seo/jsonLd';

const locale = Astro.locals.locale;
const slugParam = Astro.params.slug ?? '';
const slug = slugParam.replace(/^\/+|\/+$/g, '');
const path = localizedPath(locale, `/${slug}`);
const home = localizedPath(locale, '/');

let page = null;
try {
  page = slug ? await getPageBySlug(slug, locale) : null;
} catch (error) {
  console.error(`[slug] failed to load "${slug}" (${locale}):`, error);
}
if (!page) {
  Astro.response.status = 404;
}

let siteSettings = null;
try {
  siteSettings = await getSiteSettings(locale);
} catch (error) {
  console.error(`[slug] site settings failed (${locale}):`, error);
}
let uiLabels = null;
try {
  uiLabels = await getUiLabels(locale);
} catch (error) {
  console.error(`[slug] ui labels failed (${locale}):`, error);
}
const siteName = siteSettings?.siteName || getFallback(locale).site.siteName || '';
const labels = resolveLabels(uiLabels, locale);
const [missingBefore, missingAfter] = labels.notFound.missingPathTemplate.split('{path}');

const meta = buildMeta(
  page
    ? {
        title: page.seo?.title ?? page.title,
        description:
          page.seo?.description ??
          siteSettings?.seo?.defaultDescription ??
          siteSettings?.description ??
          undefined,
        titleTemplate: siteSettings?.seo?.titleTemplate,
        path,
        noindex: page.seo?.noindex ?? false,
        locale,
        siteName,
      }
    : {
        title: labels.notFound.pageMetaTitle,
        path,
        noindex: true,
        locale,
        siteName,
        titleTemplate: siteSettings?.seo?.titleTemplate,
      },
  env.PUBLIC_SITE_URL,
);

const jsonLd = page
  ? [
      webPageJsonLd({ title: meta.title, description: meta.description, url: meta.canonical }),
      breadcrumbJsonLd([
        { name: siteName, url: new URL(home, env.PUBLIC_SITE_URL).href },
        { name: page.title, url: meta.canonical },
      ]),
    ]
  : [];
---

<SiteLayout meta={meta} locale={locale} siteSettings={siteSettings} uiLabels={uiLabels} jsonLd={jsonLd}>
  {
    page ? (
      <div class="wrap section">
        <h1>{page.title}</h1>
        <RichText content={page.content} />
      </div>
    ) : (
      <div class="wrap section">
        <h1>{labels.notFound.heading}</h1>
        <p class="muted mt-4">
          {missingBefore}
          <code>/{slug}</code>
          {missingAfter}
        </p>
        <a class="button mt-8" href={home}>{labels.notFound.backHomeLabel}</a>
      </div>
    )
  }
</SiteLayout>
