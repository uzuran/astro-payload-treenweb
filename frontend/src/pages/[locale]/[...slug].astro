---
import RichText from '../../components/RichText.astro';
import { env } from '../../env';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPageBySlug } from '../../lib/payload/client';
import { buildMeta } from '../../lib/seo/buildMeta';
import { breadcrumbJsonLd, webPageJsonLd } from '../../lib/seo/jsonLd';

const slugParam = Astro.params.slug ?? '';
const slug = slugParam.replace(/^\/+|\/+$/g, '');

let page = null;
try {
  page = slug ? await getPageBySlug(slug) : null;
} catch (error) {
  console.error(`[slug] failed to load "${slug}":`, error);
}
if (!page) {
  Astro.response.status = 404;
}

const meta = buildMeta(
  page
    ? {
        title: page.seo?.title ?? page.title,
        description: page.seo?.description,
        path: `/${slug}`,
        noindex: page.seo?.noindex ?? false,
      }
    : { title: 'Page not found', path: `/${slug}`, noindex: true },
  env.PUBLIC_SITE_URL,
);

const jsonLd = page
  ? [
      webPageJsonLd({ title: meta.title, description: meta.description, url: meta.canonical }),
      breadcrumbJsonLd([
        { name: 'Home', url: new URL('/', env.PUBLIC_SITE_URL).href },
        { name: page.title, url: meta.canonical },
      ]),
    ]
  : [];
---

<BaseLayout meta={meta} jsonLd={jsonLd}>
  {
    page ? (
      <main>
        <h1>{page.title}</h1>
        <RichText content={page.content} />
      </main>
    ) : (
      <main>
        <h1>Page not found</h1>
        <p>
          We couldn't find <code>/{slug}</code>.
        </p>
        <a href="/">Go to the home page</a>
      </main>
    )
  }
</BaseLayout>
