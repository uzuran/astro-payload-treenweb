---
import BaseHead from '../components/BaseHead.astro';
import { DEFAULT_LOCALE, dirFor } from '../lib/locale';
import type { MetaTags } from '../lib/seo/buildMeta';
import { serializeJsonLd } from '../lib/seo/jsonLd';
import '../styles/global.css';

interface Props {
  meta: MetaTags;
  jsonLd?: unknown[];
  /** BCP-47 tag for <html lang>. Defaults to the site locale (i18n not enabled yet). */
  lang?: string;
}

const { meta, jsonLd = [], lang = DEFAULT_LOCALE } = Astro.props;
const dir = dirFor(lang);

// Preload the body + display face for this locale's script so a language
// switch doesn't reflow while the other subset loads (font-display: swap).
const fontPreloads =
  lang === 'ru'
    ? ['/fonts/manrope-cyrillic.woff2', '/fonts/oswald-cyrillic.woff2']
    : ['/fonts/manrope-latin.woff2', '/fonts/oswald-latin.woff2'];

const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;
const plausibleSrc = import.meta.env.PUBLIC_PLAUSIBLE_SRC;
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    {
      fontPreloads.map((href) => (
        <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
      ))
    }
    <BaseHead meta={meta} />
    {
      jsonLd.map((data) => (
        <script is:inline type="application/ld+json" set:html={serializeJsonLd(data)} />
      ))
    }
    {
      plausibleDomain && plausibleSrc && (
        <script is:inline defer data-domain={plausibleDomain} src={plausibleSrc} />
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>

<script>
  // The hero entrance animation is pure CSS: it runs once, on first render
  // (a full page load), with no JS dependency. This block only matters if
  // <ClientRouter/> is added later — its events don't fire otherwise.
  const root = document.documentElement;
  const HERO_SELECTOR = '.hero--fade, .hero--slide-up, .hero--zoom, .hero--neon, .hero--neon h1';
  let clientNavigated = false;

  // Suppress the hero animation while a client-side navigation swaps the DOM.
  document.addEventListener('astro:before-swap', () => {
    clientNavigated = true;
    root.setAttribute('data-navigating', '');
  });

  // Once the new page has settled: clear the transient flag, but pin the
  // swapped-in hero's animation off (inline `!important`) so removing the flag
  // cannot restart it. The initial page-load (no prior swap) is skipped, so the
  // first-load entrance still plays.
  document.addEventListener('astro:page-load', () => {
    if (clientNavigated) {
      document
        .querySelectorAll<HTMLElement>(HERO_SELECTOR)
        .forEach((el) => el.style.setProperty('animation', 'none', 'important'));
    }
    root.removeAttribute('data-navigating');
  });
</script>
