# syntax=docker/dockerfile:1
# Development image for the Astro frontend. The workspace is bind-mounted at
# /repo and host + container are both linux/amd64, so host node_modules is
# reused directly. A fresh install runs only when it is missing.
FROM node:26-bookworm-slim
# Dev-only image — never deployed, workspace bind-mounted, runs as root so the
# container can write to the mounted tree. Prod hardening lives in ./Dockerfile.
# checkov:skip=CKV_DOCKER_2: dev image, not deployed; runtime healthchecks are in compose
# checkov:skip=CKV_DOCKER_3: dev image runs as root for bind-mount writes
# Trivy skips this file entirely (--skip-files in .github/workflows/security.yml).

ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    CI=true \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0

RUN corepack enable && corepack prepare pnpm@10.32.1 --activate

WORKDIR /repo

CMD ["sh", "-lc", "([ -d node_modules/.pnpm ] || pnpm install --frozen-lockfile) && exec pnpm --filter @treenweb/frontend run dev"]
